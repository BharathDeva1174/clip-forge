# ClipForge frontend environment template.
#
# Copy to `.env.local` and adjust:
#   Copy-Item .env.example .env.local
#
# `frontend/.env.local` is git-ignored and must never be committed.
#
# NEXT_PUBLIC_* variables are inlined into the browser bundle at build time.
# Only put values that are safe to publish in them. NEVER put an API key,
# token or any other secret in a NEXT_PUBLIC_* variable.

# Base URL of the ClipForge API. The frontend calls <base url>/health.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
