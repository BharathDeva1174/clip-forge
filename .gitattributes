# Normalise line endings so the repository stores LF and every platform
# checks out the same bytes. Matches .editorconfig.

* text=auto eol=lf

# cmd.exe reads batch files line by line and behaves best with CRLF; the
# Windows launchers are authored and tested that way.
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Binary assets
*.ico binary
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.webp binary
*.mp4 binary
*.mov binary
*.mp3 binary
*.wav binary
*.sqlite binary
*.sqlite3 binary
*.db binary
