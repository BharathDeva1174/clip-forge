# ClipForge root environment template.
#
# This file documents the variables that apply to the whole repository. The
# two applications each read their own environment file from their own folder:
#
#   backend/.env        -> read by the FastAPI API and by the worker
#   frontend/.env.local -> read by Next.js (frontend-only variables)
#
# Copy the templates next to the applications and edit them there:
#
#   Copy-Item backend/.env.example backend/.env
#   Copy-Item frontend/.env.example frontend/.env.local
#
# Real environment files are git-ignored. Never commit an API key.

# ---------------------------------------------------------------------------
# Frontend (frontend/.env.local)
# ---------------------------------------------------------------------------
# Base URL of the ClipForge API. NEXT_PUBLIC_* variables are inlined into the
# browser bundle, so this must be a plain URL and must never contain a secret.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Backend (backend/.env)
# ---------------------------------------------------------------------------
# Every backend variable uses the CLIPFORGE_ prefix. The full list, with
# comments, is in backend/.env.example. The essentials:
#
# CLIPFORGE_ENVIRONMENT=development
# CLIPFORGE_DEBUG=false
# CLIPFORGE_LOG_LEVEL=INFO
# CLIPFORGE_HOST=127.0.0.1
# CLIPFORGE_PORT=8000
# CLIPFORGE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
#
# The API has no authentication, so it only binds to this machine. Set
# CLIPFORGE_ALLOW_LAN_BINDING=true to expose it to the network.
#
# Storage, database and media policy (Phase 2)
# CLIPFORGE_STORAGE_DIR=data
# CLIPFORGE_MAX_UPLOAD_BYTES=2147483648
# CLIPFORGE_MAX_VIDEO_DURATION_SECONDS=14400
# CLIPFORGE_MAX_VIDEO_DIMENSION=7680
# CLIPFORGE_ALLOWED_UPLOAD_EXTENSIONS=.mp4,.mov,.m4v,.webm,.mkv
# CLIPFORGE_ALLOWED_VIDEO_CODECS=h264,hevc,vp9,av1,mpeg4
# CLIPFORGE_FFPROBE_PATH=ffprobe
#
# Background worker (Phase 2)
# CLIPFORGE_WORKER_POLL_INTERVAL_SECONDS=2
# CLIPFORGE_WORKER_LEASE_SECONDS=300
# CLIPFORGE_WORKER_MAX_ATTEMPTS=3
#
# YouTube ingestion (Phase 2)
# CLIPFORGE_YOUTUBE_ACQUISITION_MODE=yt_dlp
#
# Audio extraction and transcription (Phase 3)
# CLIPFORGE_FFMPEG_PATH=ffmpeg
# CLIPFORGE_AUDIO_SAMPLE_RATE=16000
# CLIPFORGE_AUDIO_CHANNELS=1
# CLIPFORGE_AUDIO_TEMP_RETENTION=delete
# CLIPFORGE_TRANSCRIPTION_MODEL=tiny.en
# CLIPFORGE_TRANSCRIPTION_DEVICE=cpu
# CLIPFORGE_TRANSCRIPTION_OFFLINE=false
# CLIPFORGE_TRANSCRIPTION_MAX_CONCURRENCY=1
#
# The transcription timeout (Phase 3.1). `process` puts the model in a child
# process, which is what makes the timeout enforceable; `inline` keeps it in
# the worker and its timeout is only checked between decoded segments.
# CLIPFORGE_TRANSCRIPTION_ISOLATION=process
# CLIPFORGE_TRANSCRIPTION_TIMEOUT_SECONDS=3600
# CLIPFORGE_TRANSCRIPTION_MAX_SEGMENTS=50000
#
# Clip export (Phase 8)
# CLIPFORGE_CLIP_EXPORT_MAX_ITEMS=50
# CLIPFORGE_CLIP_EXPORT_MAX_BYTES=1073741824
#
# The AI provider configuration is not here: it is saved in the database and
# managed from the Integrations page, and the key lives in the operating
# system's credential store.
#
