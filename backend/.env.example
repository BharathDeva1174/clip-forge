# ClipForge API environment template.
#
# Copy to `backend/.env` and adjust as needed:
#   Copy-Item .env.example .env
#
# `backend/.env` is git-ignored and must never be committed.
# Every variable uses the CLIPFORGE_ prefix.

# development | test | production
CLIPFORGE_ENVIRONMENT=development

# The name and the version the API reports. Both are informational.
CLIPFORGE_APP_NAME=ClipForge API
CLIPFORGE_APP_VERSION=1.2.0

# Never enable in a shared environment: it turns on verbose error output.
CLIPFORGE_DEBUG=false

# DEBUG | INFO | WARNING | ERROR
CLIPFORGE_LOG_LEVEL=INFO

# Local bind address and port for the API (http://localhost:8000).
CLIPFORGE_HOST=127.0.0.1
CLIPFORGE_PORT=8000

# The API has no authentication, so it only binds to this machine. Setting the
# host to anything other than a loopback address is refused unless this is
# explicitly turned on.
# CLIPFORGE_ALLOW_LAN_BINDING=false

# Comma-separated list of browser origins allowed to call the API.
# Wildcards are rejected: credentials are enabled, so list origins explicitly.
CLIPFORGE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# Storage and database (Phase 2)
# ---------------------------------------------------------------------------
# Root of everything the application writes: uploads, sources, scratch space
# and the SQLite database. Relative paths resolve against the working
# directory, so start the API and the worker from the `backend` folder.
CLIPFORGE_STORAGE_DIR=data

# Optional override for the database location. When unset the database lives at
# <CLIPFORGE_STORAGE_DIR>/database/clipforge.db.
# CLIPFORGE_DATABASE_PATH=data/database/clipforge.db

# Maximum accepted upload size in bytes (2 GiB by default).
CLIPFORGE_MAX_UPLOAD_BYTES=2147483648

# Media policy applied to every accepted source.
CLIPFORGE_MAX_VIDEO_DURATION_SECONDS=14400
CLIPFORGE_MAX_VIDEO_DIMENSION=7680
CLIPFORGE_ALLOWED_UPLOAD_EXTENSIONS=.mp4,.mov,.m4v,.webm,.mkv
CLIPFORGE_ALLOWED_VIDEO_CODECS=h264,hevc,vp9,av1,mpeg4

# ---------------------------------------------------------------------------
# Media tools (Phase 2)
# ---------------------------------------------------------------------------
# Path to the FFprobe executable. Use an absolute path if it is not on PATH.
CLIPFORGE_FFPROBE_PATH=ffprobe
CLIPFORGE_FFPROBE_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------------------
# Audio extraction (Phase 3)
# ---------------------------------------------------------------------------
# Path to the FFmpeg executable. Use an absolute path if it is not on PATH.
CLIPFORGE_FFMPEG_PATH=ffmpeg

# How long FFmpeg may spend extracting the audio of one source.
CLIPFORGE_FFMPEG_TIMEOUT_SECONDS=1800

# The format the speech engine reads. 16 kHz mono is what Whisper expects.
CLIPFORGE_AUDIO_SAMPLE_RATE=16000
CLIPFORGE_AUDIO_CHANNELS=1

# How long a source may be before its audio is refused.
CLIPFORGE_AUDIO_MAX_DURATION_SECONDS=14400

# The largest extracted audio file that is accepted.
CLIPFORGE_AUDIO_MAX_BYTES=2147483648

# How much free disk space must be available before an extraction starts.
CLIPFORGE_AUDIO_MIN_FREE_DISK_BYTES=536870912

# What happens to the extracted audio once the transcription is done.
# `delete` removes it immediately; `keep` leaves it in the scratch directory.
CLIPFORGE_AUDIO_TEMP_RETENTION=delete

# ---------------------------------------------------------------------------
# Transcription (Phase 3)
# ---------------------------------------------------------------------------
# The Whisper model to use. It is downloaded once into the model cache and
# then used entirely offline.
#   tiny.en  - fastest, least accurate   (about 75 MB)
#   base.en  - a good default            (about 145 MB)
#   small.en - more accurate, slower     (about 480 MB)
#
# A model repository id (owner/name) or the path of a local model directory
# is also accepted. A name that is neither is refused when the settings are
# read, before anything is downloaded.
CLIPFORGE_TRANSCRIPTION_MODEL=tiny.en

# Where the model runs. `cpu` is the default; no GPU is required.
CLIPFORGE_TRANSCRIPTION_DEVICE=cpu

# How the inference is run.
#   process - the model runs in a child process of the worker. The timeout
#             is a real one: a stalled inference is stopped by ending the
#             process that is doing it. This is the default.
#   inline  - the model runs inside the worker. The timeout is only checked
#             between decoded segments, so one slow inference can overshoot
#             it. Use this only where a child process cannot be started.
CLIPFORGE_TRANSCRIPTION_ISOLATION=process

# The quantisation used by the decoder. Leave unset to derive it from the
# device (int8 on the CPU, float16 on a GPU).
# CLIPFORGE_TRANSCRIPTION_COMPUTE_TYPE=int8

# The spoken language. Leave unset to detect it.
# CLIPFORGE_TRANSCRIPTION_LANGUAGE=en

# Where the model files are cached. Leave unset to use
# <CLIPFORGE_STORAGE_DIR>/models.
# CLIPFORGE_TRANSCRIPTION_CACHE_DIR=data/models

# When true the engine never reaches the network: a model that is not in the
# cache produces an actionable error instead of a silent download.
CLIPFORGE_TRANSCRIPTION_OFFLINE=false

# How long a single transcription may run, in seconds.
#
# In `process` mode this is a hard limit: the inference is stopped, the
# child process is terminated and reaped, and the job fails with
# `transcription_timeout`. The bound is this value plus a short termination
# grace period.
CLIPFORGE_TRANSCRIPTION_TIMEOUT_SECONDS=3600

# How many transcriptions may run at the same time. In `process` mode there
# is exactly one inference process, so the effective concurrency is one.
CLIPFORGE_TRANSCRIPTION_MAX_CONCURRENCY=1

# The beam size used by the decoder.
CLIPFORGE_TRANSCRIPTION_BEAM_SIZE=5

# Whether the voice-activity filter is used to skip silence.
CLIPFORGE_TRANSCRIPTION_VAD_FILTER=true

# An upper bound on the number of tokens the decoder may produce. Leave unset
# for no limit.
# CLIPFORGE_TRANSCRIPTION_MAX_NEW_TOKENS=

# The largest number of segments one transcript may hold. The default is far
# above what a four-hour recording produces at a normal speaking rate; it
# exists so that a malformed model output cannot make the worker collect an
# unbounded number of segments.
CLIPFORGE_TRANSCRIPTION_MAX_SEGMENTS=50000

# ---------------------------------------------------------------------------
# Background worker (Phase 2)
# ---------------------------------------------------------------------------
# How often the worker looks for a queued job.
CLIPFORGE_WORKER_POLL_INTERVAL_SECONDS=2

# How long a claimed job stays owned before another worker may recover it.
CLIPFORGE_WORKER_LEASE_SECONDS=300

# How many times a job with a transient failure is retried.
CLIPFORGE_WORKER_MAX_ATTEMPTS=3

# How long the worker waits for a remote download before giving up.
CLIPFORGE_WORKER_ACQUISITION_TIMEOUT_SECONDS=1800

# ---------------------------------------------------------------------------
# Database (Phase 2)
# ---------------------------------------------------------------------------
# How long SQLite waits for a lock before giving up.
CLIPFORGE_DATABASE_BUSY_TIMEOUT_SECONDS=30

# WAL keeps readers from blocking the writer. Disable it if the database is
# ever placed on a network share, where WAL is not supported.
CLIPFORGE_DATABASE_WAL_MODE=true

# ---------------------------------------------------------------------------
# YouTube ingestion (Phase 2)
# ---------------------------------------------------------------------------
# `yt_dlp` uses the yt-dlp package. `disabled` refuses every YouTube
# submission and points the user at local uploads instead.
CLIPFORGE_YOUTUBE_ACQUISITION_MODE=yt_dlp

# Exact hostnames that may be used for a YouTube submission.
CLIPFORGE_YOUTUBE_ALLOWED_HOSTS=youtube.com,www.youtube.com,m.youtube.com,youtu.be,www.youtu.be

# Maximum size of a downloaded YouTube video.
CLIPFORGE_YOUTUBE_MAX_BYTES=2147483648

# ---------------------------------------------------------------------------
# Clip generation (Phase 5)
# ---------------------------------------------------------------------------
# The shortest and the longest clip that may be rendered.
CLIPFORGE_CLIP_MIN_DURATION_SECONDS=1
CLIPFORGE_CLIP_MAX_DURATION_SECONDS=180

# How long one render may run before it is stopped.
CLIPFORGE_CLIP_FFMPEG_TIMEOUT_SECONDS=300

# How many renders may run at the same time. The worker renders one at a
# time, so this is a ceiling rather than a target.
CLIPFORGE_CLIP_MAX_CONCURRENCY=1

# How far the measured length of a rendered clip may be from the length
# that was asked for, in seconds. A clip outside the tolerance fails rather
# than being quietly shifted to a keyframe.
CLIPFORGE_CLIP_DURATION_TOLERANCE_SECONDS=0.5

# The FFmpeg encoder preset: ultrafast, superfast, veryfast, faster, fast,
# medium, slow, slower, veryslow. "veryfast" is a good trade-off for a
# local prototype.
CLIPFORGE_CLIP_ENCODER_PRESET=veryfast

# ---------------------------------------------------------------------------
# Clip export (Phase 8)
# ---------------------------------------------------------------------------
# An export is built into a temporary file and streamed back, so its memory
# use is bounded by these two limits. The number of clips and their combined
# on-disk size are both checked before any archive is assembled.
CLIPFORGE_CLIP_EXPORT_MAX_ITEMS=50
CLIPFORGE_CLIP_EXPORT_MAX_BYTES=1073741824

# ---------------------------------------------------------------------------
# Formatted clips (Phase 6)
# ---------------------------------------------------------------------------
# How long one formatting render may run before it is stopped. A portrait
# render is slower than a landscape one, because the picture is scaled up
# and the captions are drawn, so it gets its own, longer limit.
CLIPFORGE_FORMAT_FFMPEG_TIMEOUT_SECONDS=600

# How far the measured length of a formatted clip may differ from the
# measured length of the clip it came from, in seconds. The re-encode is
# not expected to be bit-exact, but a whole second of difference would mean
# something is wrong.
CLIPFORGE_FORMAT_DURATION_TOLERANCE_SECONDS=0.5

# The FFmpeg encoder preset for a formatted clip.
CLIPFORGE_FORMAT_ENCODER_PRESET=veryfast

# ---------------------------------------------------------------------------
# AI integrations (Phase 4)
# ---------------------------------------------------------------------------
# The provider configuration is NOT here. It is saved in the database and
# managed from the Integrations page, so that more than one provider can be
# configured and switched between. The API key for each configuration lives
# in the operating system's credential store, and only a reference to it
# reaches this database.
#
# See docs/DECISIONS.md (D35) and the README section "Integrations".
#
# How long one provider request may take before the transport gives up.
# Free-tier and reasoning models can take minutes to answer one window of a
# long transcript. Raise this if the connection test or an analysis fails
# with `ai_timeout`.
#CLIPFORGE_AI_REQUEST_TIMEOUT_SECONDS=300
#
# How many times the transport retries one provider request on a retryable
# failure (network error, 429, 5xx) with exponential backoff. Free tiers
# fail in bursts; a thin budget turns one busy minute into a failed analysis.
#CLIPFORGE_AI_MAX_RETRIES=6

# How many times one window may be attempted before the analysis gives up on
# it, and the ceiling on the exponential backoff between those attempts.
#CLIPFORGE_AI_MAX_REQUEST_ATTEMPTS=3
#CLIPFORGE_AI_MAX_BACKOFF_SECONDS=30

# The wall-clock budget for a whole analysis, across every window and every
# backoff pause. The lease is renewed in the background during each provider
# call, so a long call no longer has to fit inside CLIPFORGE_WORKER_LEASE_SECONDS;
# this deadline is what bounds the analysis instead.
#CLIPFORGE_AI_ANALYSIS_DEADLINE_SECONDS=900

# How a long transcript is split into provider requests. A window carries at
# most this many segments and this many characters, consecutive windows overlap
# by the given number of segments, and a window smaller than the minimum is
# never planned. A window rejected for exceeding the model's context limit is
# split and retried.
#CLIPFORGE_AI_MAX_SEGMENTS_PER_WINDOW=120
#CLIPFORGE_AI_MIN_SEGMENTS_PER_WINDOW=5
#CLIPFORGE_AI_WINDOW_OVERLAP_SEGMENTS=4
#CLIPFORGE_AI_MAX_TRANSCRIPT_CHARACTERS=12000

# How many provider requests may be in flight at once. One is the default: a
# local or free-tier endpoint is usually the slowest part of the pipeline and
# parallelising it only multiplies 429s.
#CLIPFORGE_AI_MAX_CONCURRENT_REQUESTS=1

# ---------------------------------------------------------------------------
# Lease renewal
# ---------------------------------------------------------------------------
# How often the worker renews the lease of the piece of work it owns. During a
# clip or format render this same tick is what checks whether the parent job
# was cancelled, so lowering it makes cancellation stop the child sooner.
#CLIPFORGE_WORKER_LEASE_RENEWAL_INTERVAL_SECONDS=30
