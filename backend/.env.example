# ClipForge API environment template.
#
# Copy to `backend/.env` and adjust as needed:
#   Copy-Item .env.example .env
#
# `backend/.env` is git-ignored and must never be committed.
# Every variable uses the CLIPFORGE_ prefix.

# development | test | production
CLIPFORGE_ENVIRONMENT=development

# Never enable in a shared environment: it turns on verbose error output.
CLIPFORGE_DEBUG=false

# DEBUG | INFO | WARNING | ERROR
CLIPFORGE_LOG_LEVEL=INFO

# Local bind address and port for the API (http://localhost:8000).
CLIPFORGE_HOST=127.0.0.1
CLIPFORGE_PORT=8000

# Comma-separated list of browser origins allowed to call the API.
# Wildcards are rejected: credentials are enabled, so list origins explicitly.
CLIPFORGE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# Storage and database (Phase 2)
# ---------------------------------------------------------------------------
# Root of everything the application writes: uploads, sources, scratch space
# and the SQLite database. Relative paths resolve against the working
# directory, so start the API and the worker from the `backend` folder.
CLIPFORGE_STORAGE_DIR=data

# Optional override for the database location. When unset the database lives at
# <CLIPFORGE_STORAGE_DIR>/database/clipforge.db.
# CLIPFORGE_DATABASE_PATH=data/database/clipforge.db

# Maximum accepted upload size in bytes (2 GiB by default).
CLIPFORGE_MAX_UPLOAD_BYTES=2147483648

# Media policy applied to every accepted source.
CLIPFORGE_MAX_VIDEO_DURATION_SECONDS=14400
CLIPFORGE_MAX_VIDEO_DIMENSION=7680
CLIPFORGE_ALLOWED_UPLOAD_EXTENSIONS=.mp4,.mov,.m4v,.webm,.mkv
CLIPFORGE_ALLOWED_VIDEO_CODECS=h264,hevc,vp9,av1,mpeg4

# ---------------------------------------------------------------------------
# Media tools (Phase 2)
# ---------------------------------------------------------------------------
# Path to the FFprobe executable. Use an absolute path if it is not on PATH.
CLIPFORGE_FFPROBE_PATH=ffprobe
CLIPFORGE_FFPROBE_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------------------
# Background worker (Phase 2)
# ---------------------------------------------------------------------------
# How often the worker looks for a queued job.
CLIPFORGE_WORKER_POLL_INTERVAL_SECONDS=2

# How long a claimed job stays owned before another worker may recover it.
CLIPFORGE_WORKER_LEASE_SECONDS=300

# How many times a job with a transient failure is retried.
CLIPFORGE_WORKER_MAX_ATTEMPTS=3

# How long the worker waits for a remote download before giving up.
CLIPFORGE_WORKER_ACQUISITION_TIMEOUT_SECONDS=1800

# ---------------------------------------------------------------------------
# Database (Phase 2)
# ---------------------------------------------------------------------------
# How long SQLite waits for a lock before giving up.
CLIPFORGE_DATABASE_BUSY_TIMEOUT_SECONDS=30

# WAL keeps readers from blocking the writer. Disable it if the database is
# ever placed on a network share, where WAL is not supported.
CLIPFORGE_DATABASE_WAL_MODE=true

# ---------------------------------------------------------------------------
# YouTube ingestion (Phase 2)
# ---------------------------------------------------------------------------
# `yt_dlp` uses the yt-dlp package. `disabled` refuses every YouTube
# submission and points the user at local uploads instead.
CLIPFORGE_YOUTUBE_ACQUISITION_MODE=yt_dlp

# Exact hostnames that may be used for a YouTube submission.
CLIPFORGE_YOUTUBE_ALLOWED_HOSTS=youtube.com,www.youtube.com,m.youtube.com,youtu.be,www.youtu.be

# Maximum size of a downloaded YouTube video.
CLIPFORGE_YOUTUBE_MAX_BYTES=2147483648

# --- Reserved for Phase 4 (AI highlight detection) -----------------------------
# Backend-only credentials. Never place these in a NEXT_PUBLIC_* variable and
# never commit them. Leave commented out until a provider is chosen.
# CLIPFORGE_LLM_API_KEY=
# CLIPFORGE_LLM_BASE_URL=
# CLIPFORGE_LLM_MODEL=
